name: CI/CD Pipeline

on:
  push:
    branches:
      - main

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: maven

      - name: Generate Maven settings.xml
        run: |
          mkdir -p ~/.m2
          cat > ~/.m2/settings.xml <<EOF
          <settings>
            <servers>
              <server>
                <id>anypoint-exchange-v3</id>
                <username>${{ secrets.MULE_EE_USERNAME }}</username>
                <password>${{ secrets.MULE_EE_PASSWORD }}</password>
              </server>
            </servers>
            <profiles>
              <profile>
                <id>mule-extra-repos</id>
                <activation><activeByDefault>true</activeByDefault></activation>
                <repositories>
                  <repository>
                    <id>MuleRepository</id>
                    <url>https://repository.mulesoft.org/releases/</url>
                  </repository>
                </repositories>
              </profile>
            </profiles>
          </settings>
          EOF

      - name: Build and Test
        run: mvn clean deploy

  provision-api:
    runs-on: ubuntu-latest
    needs: build-and-test
    outputs:
      api_id: ${{ steps.create-api.outputs.api_id }}
    steps:
      - name: Get Bearer Token
        id: get-token
        run: |
          TOKEN=$(curl -s -X POST https://anypoint.mulesoft.com/accounts/api/v2/oauth2/token \
            -H 'Content-Type: application/x-www-form-urlencoded' \
            -d "grant_type=password&username=${{ secrets.ANYPOINT_USERNAME }}&password=${{ secrets.ANYPOINT_PASSWORD }}" \
            | jq -r '.access_token')
          echo "token=$TOKEN" >> $GITHUB_OUTPUT

      - name: Create API Instance
        id: create-api
        run: |
          API_ID=$(curl -s -X POST \
            "https://anypoint.mulesoft.com/apimanager/api/v1/organizations/${{ secrets.ANYPOINT_ORG_ID }}/environments/${{ secrets.ANYPOINT_ENV_ID }}/apis" \
            -H "Authorization: Bearer ${{ steps.get-token.outputs.token }}" \
            -H "Content-Type: application/json" \
            -d '{
              "technology": "mule4",
              "endpoint": { "uri": "https://greeting-api.cloudhub.io", "proxyUri": null, "isCloudHub": false },
              "instanceLabel": "greeting-api-instance"
            }' | jq -r '.id')
          echo "api_id=$API_ID" >> $GITHUB_OUTPUT

      - name: Apply Rate Limiting Policy
        run: |
          curl -s -X POST \
            "https://anypoint.mulesoft.com/apimanager/api/v1/organizations/${{ secrets.ANYPOINT_ORG_ID }}/environments/${{ secrets.ANYPOINT_ENV_ID }}/apis/${{ steps.create-api.outputs.api_id }}/policies" \
            -H "Authorization: Bearer ${{ steps.get-token.outputs.token }}" \
            -H "Content-Type: application/json" \
            -d '{
              "groupId": "68ef9520-24e9-4cf2-b2f5-620025690913",
              "assetId": "rate-limiting",
              "assetVersion": "1.3.3",
              "configuration": {
                "rateLimits": [{ "maximumRequests": 3, "timePeriodInMilliseconds": 60000 }],
                "clusterizable": true,
                "exposeHeaders": false
              }
            }'

  deploy:
    runs-on: ubuntu-latest
    needs: provision-api
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: maven

      - name: Generate Maven settings.xml
        run: |
          mkdir -p ~/.m2
          cat > ~/.m2/settings.xml <<EOF
          <settings>
            <servers>
              <server>
                <id>anypoint-exchange-v3</id>
                <username>${{ secrets.MULE_EE_USERNAME }}</username>
                <password>${{ secrets.MULE_EE_PASSWORD }}</password>
              </server>
            </servers>
            <profiles>
              <profile>
                <id>mule-extra-repos</id>
                <activation><activeByDefault>true</activeByDefault></activation>
                <repositories>
                  <repository>
                    <id>MuleRepository</id>
                    <url>https://repository.mulesoft.org/releases/</url>
                  </repository>
                </repositories>
              </profile>
            </profiles>
          </settings>
          EOF

      - name: Deploy to CloudHub 2.0
        run: |
          mvn clean deploy -DmuleDeploy \
            -Danypoint.username=${{ secrets.ANYPOINT_USERNAME }} \
            -Danypoint.password=${{ secrets.ANYPOINT_PASSWORD }} \
            -Danypoint.environment=Sandbox \
            -Danypoint.target=Cloudhub-US-East-2 \
            -Danypoint.appName=greeting-api \
            -Dmule.version=4.9.0 \
            -Danypoint.platform.client_id=${{ secrets.ENV_CLIENT_ID }} \
            -Danypoint.platform.client_secret=${{ secrets.ENV_CLIENT_SECRET }} \
            -Dapi.id=${{ needs.provision-api.outputs.api_id }}